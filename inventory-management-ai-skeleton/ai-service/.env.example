# Mẫu biến môi trường AI Service (docs/08-environment.md). Không ghi giá trị thật vào repo.
# Dev: chép ra ~/.erp/ai-service.env rồi đặt AI_SERVICE_ENV_FILE trỏ tới file đó.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8090
# Bắt buộc, tối thiểu 16 ký tự; trùng với ai.service.api-key của Spring Boot.
AI_SERVICE_API_KEY=
AI_SERVICE_ENABLE_DOCS=false
# Thư mục chứa model cài sẵn, mỗi model một thư mục con theo tên (ví dụ PP-OCRv5_mobile_det).
OCR_MODEL_DIR=
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=latin_PP-OCRv5_mobile_rec
OCR_CPU_THREADS=4
OCR_MAX_FILE_SIZE=10485760
OCR_MAX_PDF_PAGES=5
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MAX_IMAGE_SIDE=2500
OCR_PDF_DPI=144
OCR_MIN_CONFIDENCE=0.85
OCR_TEXT_DIACRITICS_RELIABLE=false
# Trợ lý (AI-3): Ollama nội bộ, model cài sẵn; chỉ mục lập bằng python -m tools.build_rag_index.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:3b
CHAT_TIMEOUT_SECONDS=80
CHAT_MAX_ANSWER_TOKENS=400
CHAT_TEMPERATURE=0.2
CHAT_CONTEXT_TOKENS=4096
CHAT_MAX_QUESTION_CHARS=2000
RAG_INDEX_DIR=
RAG_TOP_K=3
RAG_MIN_SCORE=5.0
RAG_MAX_CONTEXT_CHARS=6000
LOG_LEVEL=INFO
